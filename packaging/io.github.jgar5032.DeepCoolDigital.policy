<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <action id="io.github.jgar5032.DeepCoolDigital.save-settings">
    <description>Save DC Cooler Display settings</description>
    <message>Administrator authentication is required to save DC Cooler Display settings.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/deepcool-digital/deepcool-digital-save-settings</annotate>
  </action>
</policyconfig>
